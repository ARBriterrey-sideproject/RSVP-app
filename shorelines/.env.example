# Copy to .env.local and fill in from the Firebase console
# (Project settings -> General -> Your apps -> Web app config).
#
# Leave NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true for local work: the values below
# are then ignored entirely and no real project (or billing) is required.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (see src/lib/firebase/client.ts). Leave unset and App Check is
# skipped client-side with no error — but functions/src/index.ts enforces it
# on every callable whenever this isn't the emulator, so leaving it unset
# against a real project breaks every RSVP/staff write with a "Missing or
# insufficient permissions" App Check rejection. Register a reCAPTCHA v3 site
# key against this project in Firebase Console -> App Check before setting
# this, not before.
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=
