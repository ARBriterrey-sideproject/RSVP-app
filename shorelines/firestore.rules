rules_version = '2';

/*
 * Guiding rule: clients NEVER write anything sensitive directly.
 * RSVP submission, poll votes and song requests all go through callable
 * Cloud Functions, which use the Admin SDK and bypass these rules entirely.
 * So the client-facing posture here is deliberately read-mostly — if a write
 * path is open below, that is a bug, not a convenience.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /*
     * Staff roles nest: admin > couple > coordinator. The `role` custom claim is
     * set only by the syncRole callable, against a server-side roster, and only
     * for accounts with a verified email — a phone-auth guest never carries one.
     *
     * Ranks must match RANK in src/lib/auth/roles.ts and functions/src/index.ts.
     * An unknown or absent role ranks 0, so a signed-in stranger gets nothing.
     */
    function roleRank() {
      return isSignedIn()
        ? {'admin': 3, 'couple': 2, 'coordinator': 1}
            .get(request.auth.token.get('role', ''), 0)
        : 0;
    }

    /** Anyone behind the dashboard at all. */
    function isStaff() { return roleRank() >= 1; }

    /** The couple and up. Excludes coordinators by design. */
    function isCouple() { return roleRank() >= 2; }

    function isAdmin() { return roleRank() >= 3; }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    // ---- RSVPs -------------------------------------------------------------
    // Doc id IS the phone-auth uid, which is what makes "same number returns to
    // the same record" work without any lookup.
    match /rsvps/{ownerUid} {
      // A guest can read only their own. Any staff role can read all — a
      // coordinator needs phone numbers and arrival times to arrange cars.
      allow get: if isOwner(ownerUid) || isStaff();
      allow list: if isStaff();

      // No client writes at all — not even from an admin. Creation and edits
      // go through the submitRsvp callable so that party-size caps and tier
      // immutability are enforced somewhere the client cannot reach, and the
      // speakeasy flag goes through setSpeakeasyInvite for the same reason.
      allow create, update, delete: if false;
    }

    // ---- Share links (the family QR) ---------------------------------------
    // The read-only mirror a scanned QR lands on, keyed by an unguessable code
    // that the callable mints. The code IS the capability, so `get` is open —
    // a scanner has no account and cannot be asked to sign in.
    //
    // Two things keep that safe, and both are enforced in submitRsvp, not here:
    // the mirror carries names only (no phone, travel or notes), and
    // invitation-only events are stripped out of it.
    match /invites/{shareCode} {
      allow get: if true;
      // Never listable: enumerating this collection would hand over every
      // family's code at once and defeat the unguessable id entirely.
      allow list: if false;
      allow write: if false;
    }

    // ---- The runtime overlay ------------------------------------------------
    // One document, `config/live`: the half of a wedding's facts the couple can
    // change without a rebuild — event and meal times, and the emergency
    // contacts. Everything structural stays compiled in. See WeddingOverlay in
    // src/content/schema.ts for the split and why.
    //
    // `get` is open for the same reason `invites/{shareCode}` is: the landing
    // renders before anyone signs in, and every value in here is already on the
    // face of the invitation. Nothing private may be added to this document —
    // it is world-readable to anyone who has the link.
    //
    // Writes are closed to everyone including admins. Times are not free-form:
    // mealsForEvents windows a guest's meals between their first event's start
    // and their last event's end, so an inverted pair silently empties a meal
    // list rather than failing. That check belongs somewhere a client cannot
    // reach — the updateWeddingLive callable, gated on editSchedule /
    // editEmergencyContacts.
    //
    // Replaces an earlier speculative /events/{eventId} collection that nothing
    // ever read. Two places to store an event's time is how they drift apart.
    match /config/live {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ---- Polls (v2) --------------------------------------------------------
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow write: if isCouple();
    }

    // One vote per anonymous-auth uid per poll is enforced by the compound doc
    // id (`{pollId}_{ownerUid}`) plus the castVote callable's `.create()`, which
    // throws if that id already exists — no transaction needed. Reads are open
    // to signed-in guests so results render live.
    match /pollVotes/{voteId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Song requests (v2) ------------------------------------------------
    // Cutoff (1 hour before the event, or open indefinitely if the couple/admin
    // has set config/live.songRequestsOverride) is checked server-side in the
    // submitSongRequest callable, against the event's real, overlay-adjusted
    // start time — never against anything the client sends.
    match /songRequests/{requestId} {
      // Whoever is running the music on the night — coordinator included.
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Memories (v2) -----------------------------------------------------
    // A private one-way inbox to the couple, NOT a public feed: guests may
    // create but never read back — not even their own.
    //
    // Couple and up, never coordinator. Guests write these believing they're
    // writing to the two people getting married; a logistics hire reading them
    // would break that promise silently.
    match /memories/{memoryId} {
      allow read: if isCouple();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isCouple();
    }

    // ---- Chat: one open group room, plus one concierge thread per guest ----
    // roomId is either "group" (everyone attending, plus staff) or
    // "dm_{ownerUid}" (a single guest talking to the coordinators — there is no
    // guest-to-guest messaging by design; access here is open and anonymous,
    // which is a fine trust model for a moderated room staff can see and a bad
    // one for unsupervised stranger-to-stranger DMs). All writes go through
    // sendChatMessage / moderateChatMessage so the room-targeting rule below
    // (a guest may only address their own dm_ room) and the per-uid send
    // cooldown are enforced somewhere the client cannot bypass.
    match /chats/{roomId}/messages/{messageId} {
      allow read: if roomId == "group"
                  ? (isSignedIn() || isStaff())
                  : (isStaff() || (isSignedIn() && roomId == "dm_" + request.auth.uid));
      allow write: if false;
    }

    // ---- Photo album visibility (v2) ---------------------------------------
    // One doc per event, defaulting to "private" when absent. Guests never read
    // this — there is no in-app gallery yet, upload-only this round — so it's
    // staff-only end to end. Written only by setAlbumVisibility.
    match /albumSettings/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Staff-only aggregates --------------------------------------------
    match /aggregates/{docId} {
      allow read: if isStaff();
      allow write: if false; // written by Functions only
    }

    // ---- Per-individual photo-view grants -----------------------------------
    // A coordinator has NO blanket photo access by default (see the tightened
    // photos/ rule in storage.rules) — the couple grants it to specific staff
    // one at a time via the admin-only setStaffPhotoAccess callable. Doc id is
    // the same roster identity syncRole/getStaffRoster already key off
    // (`email:<lowercased>` or `phone:<e164>`); presence + `allowed: true`
    // means granted, a missing doc means not granted. Admin SDK only, same
    // as config/live — nobody, including admin, writes this from the client.
    match /staffPhotoAccess/{identity} {
      allow read, write: if false;
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
